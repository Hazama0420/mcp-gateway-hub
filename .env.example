# .env.example
# ==============================================
# MCP Gateway Hub - Environment Variables
# ==============================================

# --- Database PostgreSQL (Supabase / Neon / self-hosted) ---
# DATABASE_URL: digunakan Prisma untuk migrasi dan koneksi (harus pakai pgbouncer=true jika via Supabase)
DATABASE_URL="postgresql://postgres:password@host:5432/postgres?pgbouncer=true"
# DIRECT_URL: koneksi langsung tanpa pgbouncer untuk Prisma migrate (opsional, tapi disarankan)
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

# --- Next.js Auth ---
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://mcp-gateway.yourdomain.com"

# --- Enkripsi (wajib 32 karakter) ---
ENCRYPTION_MASTER_KEY="32_characters_long_secret_key_here_12345"

# --- URL Publik Aplikasi ---
NEXT_PUBLIC_APP_URL="https://mcp-gateway.yourdomain.com"

# --- Opsional: untuk logging lebih detail ---
# NODE_ENV="production"