generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER
// ============================================
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password_hash String?
  created_at    DateTime  @default(now())

  endpoints    McpEndpoint[]
  combos       Combo[]
  integrations Integration[]
  accounts     Account[]
  sessions     Session[]
  logs         ExecutionLog[]
  oauth_codes  OAuthAuthorizationCode[]
  oauth_refresh_tokens OAuthRefreshToken[]
  oauth_clients OAuthClient[]
}

// ============================================
// MCP ENDPOINT
// ============================================
model McpEndpoint {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  is_active  Boolean  @default(true)
  api_key_hash String?
  created_at DateTime @default(now())

  user         User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  services     EndpointService[]
  combo_links  ComboEndpoint[]
  logs         ExecutionLog[]
  integrations EndpointIntegration[]
  oauth_codes  OAuthAuthorizationCode[]
  oauth_refresh_tokens OAuthRefreshToken[]
  oauth_clients OAuthClient[]
}

// ============================================
// LEGACY / BUILT-IN ENDPOINT SERVICES
// ============================================
model EndpointService {
  id               String   @id @default(uuid())
  endpoint_id      String
  service_type     String
  encrypted_config String
  iv               String
  tag              String
  created_at       DateTime @default(now())

  endpoint McpEndpoint @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)

  @@index([endpoint_id])
}

// ============================================
// EXECUTION LOG & AUDIT TRAIL
// ============================================
model ExecutionLog {
  id                String       @id @default(uuid())
  execution_id      String       @default(uuid())
  endpoint_id       String?
  user_id           String?
  tool_name         String
  source            String       @default("MCP") // MCP, PLAYGROUND, CONTROL_PLANE, SECURITY
  status            String       // SUCCESS, FAILED, BLOCKED, TIMEOUT, RATE_LIMITED, AUTH_FAILED
  error_category    String?      // VALIDATION, AUTHENTICATION, AUTHORIZATION, RATE_LIMIT, SSRF, DATABASE, EXTERNAL_API, TIMEOUT, INTERNAL
  execution_time_ms Int          @default(0)
  result_size       Int?
  metadata          Json?        // Safe metadata only (NO secrets)
  created_at        DateTime     @default(now())

  endpoint McpEndpoint? @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)
  user     User?        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([endpoint_id])
  @@index([user_id])
  @@index([created_at])
  @@index([status])
  @@index([tool_name])
  @@index([execution_id])
}

// ============================================
// INTEGRATION BUILDER
// Definisi integrasi milik masing-masing user
// ============================================
model Integration {
  id          String   @id @default(uuid())
  user_id     String   // Isolasi kepemilikan integrasi per user
  name        String
  slug        String
  description String?
  icon        String?
  category    String?
  base_url    String
  auth_type             String   @default("none")
  auth_config           Json?
  encrypted_auth_config String?
  auth_config_iv        String?
  auth_config_tag       String?
  is_active             Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user      User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tools     IntegrationTool[]
  endpoints EndpointIntegration[]

  @@unique([user_id, slug]) // Slug unik per user
  @@index([user_id])
  @@index([is_active])
  @@index([category])
}

// ============================================
// INTEGRATION TOOLS
// Definisi MCP tool dalam sebuah integrasi
// ============================================
model IntegrationTool {
  id               String   @id @default(uuid())
  integration_id   String
  name             String
  description      String?
  method           String
  path             String
  input_schema     Json?
  headers_template Json?
  query_template   Json?
  body_template    Json?
  response_mapping Json?
  permission       String   @default("read")
  is_enabled       Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  integration Integration @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  @@unique([integration_id, name])
  @@index([integration_id])
  @@index([is_enabled])
}

// ============================================
// ENDPOINT INTEGRATION
// Menghubungkan integration dengan endpoint user
// ============================================
model EndpointIntegration {
  id               String   @id @default(uuid())
  endpoint_id      String
  integration_id   String
  encrypted_config String?
  iv               String?
  tag              String?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  endpoint    McpEndpoint @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  @@unique([endpoint_id, integration_id])
  @@index([endpoint_id])
  @@index([integration_id])
  @@index([is_active])
}

// ============================================
// NEXTAUTH - ACCOUNT
// ============================================
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================
// NEXTAUTH - SESSION
// ============================================
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// NEXTAUTH - VERIFICATION TOKEN
// ============================================
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// OAUTH 2.1 - CLIENT REGISTRATION (RFC 7591)
// ============================================
model OAuthClient {
  id                         String    @id @default(uuid())
  client_id                  String    @unique
  client_secret_hash         String?
  client_name                String?
  client_type                String    @default("confidential") // "confidential" or "public"
  client_uri                 String?
  logo_uri                   String?
  redirect_uris              String[]  // Registered redirect URIs
  grant_types                String[]  @default(["authorization_code", "refresh_token"])
  response_types             String[]  @default(["code"])
  token_endpoint_auth_method String    @default("client_secret_post") // "none" for public, "client_secret_post", "client_secret_basic"
  scope                      String?
  contacts                   String[]  @default([])
  tos_uri                    String?
  policy_uri                 String?
  jwks_uri                   String?
  software_id                String?
  software_version           String?
  client_secret_expires_at   DateTime?
  endpoint_id                String?
  combo_id                   String?
  user_id                    String?
  is_active                  Boolean   @default(true)
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  endpoint       McpEndpoint?             @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)
  combo          Combo?                   @relation(fields: [combo_id], references: [id], onDelete: Cascade)
  user           User?                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  codes          OAuthAuthorizationCode[]
  refresh_tokens OAuthRefreshToken[]

  @@index([client_id])
  @@index([endpoint_id])
  @@index([combo_id])
  @@index([user_id])
  @@index([is_active])
}

// ============================================
// OAUTH 2.1 - AUTHORIZATION CODE
// ============================================
model OAuthAuthorizationCode {
  id                    String    @id @default(uuid())
  code_hash             String    @unique
  client_id             String
  user_id               String
  endpoint_id           String
  redirect_uri          String
  code_challenge        String
  code_challenge_method String    @default("S256")
  scope                 String?
  resource              String?
  expires_at            DateTime
  used_at               DateTime?
  created_at            DateTime  @default(now())

  client   OAuthClient @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
  user     User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint McpEndpoint @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)

  @@index([code_hash])
  @@index([client_id])
  @@index([user_id])
  @@index([endpoint_id])
  @@index([expires_at])
}

// ============================================
// OAUTH 2.1 - REFRESH TOKEN
// ============================================
model OAuthRefreshToken {
  id          String    @id @default(uuid())
  token_hash  String    @unique
  client_id   String
  user_id     String
  endpoint_id String
  scope       String?
  resource    String?
  expires_at  DateTime
  revoked_at  DateTime?
  created_at  DateTime  @default(now())

  client   OAuthClient @relation(fields: [client_id], references: [client_id], onDelete: Cascade)
  user     User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint McpEndpoint @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)

  @@index([token_hash])
  @@index([client_id])
  @@index([user_id])
  @@index([endpoint_id])
  @@index([expires_at])
}

// ============================================
// COMBO - ADAPTER COMPOSITION LAYER
// ============================================
model Combo {
  id          String   @id @default(uuid())
  user_id     String
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user          User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoints     ComboEndpoint[]
  oauth_clients OAuthClient[]

  @@index([user_id])
  @@index([is_active])
}

model ComboEndpoint {
  id          String   @id @default(uuid())
  combo_id    String
  endpoint_id String
  created_at  DateTime @default(now())

  combo    Combo       @relation(fields: [combo_id], references: [id], onDelete: Cascade)
  endpoint McpEndpoint @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)

  @@unique([combo_id, endpoint_id])
  @@index([combo_id])
  @@index([endpoint_id])
}